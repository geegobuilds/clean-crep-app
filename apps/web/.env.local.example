NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-local-or-hosted-anon-key
# Creppie website chat: the n8n production webhook URL for Creppie (Receive
# Message node, path ccj-booking). Leave unset to show the plain WhatsApp bubble.
# Server-only (no NEXT_PUBLIC_ prefix) so the URL never reaches the browser.
CREPPIE_WEBHOOK_URL=
