{
  "name": "clean-crep-app",
  "description": "Customer mobile app, landing page, and staff operator dashboard for Clean Crep Jamaica (Expo + Next.js + Supabase).",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "e2e": "npm run e2e --workspace=apps/mobile --",
    "postinstall": "patch-package"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
